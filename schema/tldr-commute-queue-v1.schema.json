{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brad-balfour.github.io/llm-wiki/schema/tldr-commute-queue-v1.schema.json",
  "title": "TLDR commute queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_version",
    "newsletter",
    "edition_date",
    "source_email",
    "headline_only",
    "in_depth"
  ],
  "properties": {
    "queue_version": { "const": "tldr-commute-queue.v1" },
    "newsletter": { "type": "string", "minLength": 1, "maxLength": 100 },
    "edition_date": { "type": "string", "format": "date" },
    "source_email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gmail_message_id", "subject", "sender"],
      "properties": {
        "gmail_message_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sender": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "headline_only": { "$ref": "#/$defs/items" },
    "in_depth": { "$ref": "#/$defs/items" }
  },
  "$defs": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_item_id",
        "title",
        "summary",
        "url",
        "interest_level",
        "interest_score",
        "consumption_depth",
        "depth_score",
        "commute_behavior",
        "signals",
        "reason",
        "profile_version",
        "prompt_version",
        "provider",
        "model",
        "parser_version",
        "route_version",
        "classified_at",
        "routed_at"
      ],
      "properties": {
        "source_item_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "interest_level": { "enum": ["interested", "maybe", "uninterested"] },
        "interest_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "consumption_depth": { "enum": ["headline_only", "in_depth"] },
        "depth_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "commute_behavior": { "type": "string", "minLength": 1 },
        "signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "profile_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "route_version": { "type": "string", "minLength": 1 },
        "classified_at": { "type": "string", "format": "date-time" },
        "routed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
