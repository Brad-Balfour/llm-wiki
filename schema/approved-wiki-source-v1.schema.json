{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brad-balfour.github.io/llm-wiki/schema/approved-wiki-source-v1.schema.json",
  "title": "Approved TLDR wiki source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval", "source", "entry"],
  "properties": {
    "schema_version": { "const": "approved-wiki-source.v1" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "public", "approved_at"],
      "properties": {
        "status": { "const": "approved" },
        "public": { "const": true },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_item_id",
        "source_path",
        "source_type",
        "title",
        "url",
        "newsletter",
        "edition_date"
      ],
      "properties": {
        "source_item_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "pattern": "^sources/tldr/" },
        "source_type": { "const": "tldr" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "newsletter": { "type": "string", "minLength": 1 },
        "edition_date": { "type": "string", "format": "date" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "title",
        "aliases",
        "tags",
        "confidence",
        "summary",
        "key_ideas",
        "related"
      ],
      "properties": {
        "type": { "enum": ["concept", "tool", "person", "event"] },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "summary": { "type": "string", "minLength": 1 },
        "key_ideas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
