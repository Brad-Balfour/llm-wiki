{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brad-balfour.github.io/llm-wiki/schema/tldr-commute-reference-v4.schema.json",
  "title": "TLDR commute reference file v4",
  "description": "Identity, source, classification, routing, and export data paired by position with a v4 playback file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_version",
    "main_filename",
    "main_sha256",
    "newsletter",
    "edition_date",
    "source_email",
    "daily_generation_id",
    "total_items",
    "profile_version",
    "prompt_version",
    "provider",
    "model",
    "parser_version",
    "route_version",
    "coverage_decisions",
    "items"
  ],
  "properties": {
    "queue_version": { "const": "tldr-commute-queue.v4" },
    "main_filename": { "type": "string", "minLength": 1 },
    "main_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "newsletter": { "type": "string", "minLength": 1, "maxLength": 100 },
    "edition_date": { "type": "string", "format": "date" },
    "source_email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gmail_message_id", "sender", "delivered_at"],
      "properties": {
        "gmail_message_id": { "type": "string", "minLength": 1 },
        "sender": { "type": "string", "minLength": 1, "maxLength": 300 },
        "delivered_at": { "type": "string", "format": "date-time" }
      }
    },
    "daily_generation_id": { "type": "string", "minLength": 1 },
    "total_items": { "type": "integer", "minimum": 0 },
    "profile_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "route_version": { "type": "string", "minLength": 1 },
    "coverage_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageDecision" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "source_item_id",
        "title",
        "description",
        "author",
        "publication",
        "attribution",
        "url",
        "source_occurrences",
        "selected_source_occurrence_id",
        "coverage",
        "interest_level",
        "interest_score",
        "consumption_depth",
        "depth_score",
        "commute_behavior",
        "signals",
        "reason",
        "classified_at",
        "routed_at"
      ],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "source_item_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "author": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publication": { "type": "string", "minLength": 1, "maxLength": 300 },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolved_url", "author_source", "publication_source", "lookup_attempts"],
          "properties": {
            "resolved_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "author_source": {
              "enum": ["newsletter", "article_page", "no_authors_listed", "lookup_failed"]
            },
            "publication_source": {
              "enum": ["newsletter", "article_page", "hostname_fallback"]
            },
            "lookup_attempts": { "type": "integer", "minimum": 0, "maximum": 2 }
          }
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_occurrences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceOccurrence" }
        },
        "selected_source_occurrence_id": { "type": "string", "minLength": 1 },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "related_retained_item", "decision_reason", "update_note"],
          "properties": {
            "status": { "enum": ["original", "deduplicated", "useful_update", "uncertain"] },
            "related_retained_item": {
              "anyOf": [{ "$ref": "#/$defs/retainedItem" }, { "type": "null" }]
            },
            "decision_reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "update_note": {
              "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }]
            }
          }
        },
        "interest_level": { "enum": ["interested", "maybe", "uninterested"] },
        "interest_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "consumption_depth": { "enum": ["headline_only", "in_depth"] },
        "depth_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "commute_behavior": { "type": "string", "minLength": 1 },
        "signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "classified_at": { "type": "string", "format": "date-time" },
        "routed_at": { "type": "string", "format": "date-time" }
      }
    },
    "sourceOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "newsletter",
        "source_item_id",
        "source_order",
        "title",
        "description",
        "url"
      ],
      "properties": {
        "occurrence_id": { "type": "string", "minLength": 1 },
        "newsletter": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source_item_id": { "type": "string", "minLength": 1 },
        "source_order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "retainedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_filename", "source_item_id"],
      "properties": {
        "main_filename": { "type": "string", "minLength": 1 },
        "source_item_id": { "type": "string", "minLength": 1 }
      }
    },
    "coverageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_occurrence_id", "outcome", "retained_item", "reason", "new_information"],
      "properties": {
        "source_occurrence_id": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": ["removed_exact_url", "removed_same_story", "kept_update", "kept_uncertain"]
        },
        "retained_item": { "$ref": "#/$defs/retainedItem" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "new_information": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }]
        }
      }
    }
  }
}
